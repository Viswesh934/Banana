# FalkorDB Local / Docker Connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# FalkorDB Cloud (Optional - uncomment if using FalkorDB Cloud instance)
# FALKORDB_URL=falkor://default:your-cloud-password@cloud-instance.falkordb.cloud:6379
# FALKORDB_SSL=true

# Dual Graph Configuration
BANANA_DEMAND_GRAPH_NAME=banana_demand
BANANA_KNOWLEDGE_GRAPH_NAME=banana_knowledge

# Gemini 3.5 Flash Configuration (Required for live agent inference and multimodal vision)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Token Budget Default
DEFAULT_TOKEN_BUDGET=1600
